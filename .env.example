# X (Twitter) Developer API credentials. Paste your key(s) below. Never commit this file.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Dashboard login (read-only site)
DASHBOARD_PASSWORD=change-me

# Account to track (without @) and poll interval (min 60s; mind your X API rate limits/quota)
X_USERNAME=
POLL_INTERVAL_SECONDS=300
PORT=3000

# Scanner: accounts to watch (comma-separated, no @), optional keyword filter, and Jev labelling
X_WATCH_ACCOUNTS=
X_SEARCH_QUERY=
X_INCLUDE_REPLIES=false
MAX_POSTS_PER_POLL=50
JEV_API_KEY=
JEV_CONCURRENCY=4
JEV_PREFERENCE=

# Reply-opportunity tuning for @dreamworkhq
# Slack incoming-webhook URL: every "reply now" post is sent here with its tweet URL
SLACK_WEBHOOK_URL=
# Posts below this weighted engagements/hour, or older than this many hours, are auto-skipped (no Jev call)
MIN_VELOCITY_PER_HOUR=30
MAX_POST_AGE_HOURS=6
# Optional: override the built-in Dreamwork description used in the prompt
DREAMWORK_DESCRIPTION=
