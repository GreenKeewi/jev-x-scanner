# X (Twitter) Developer API credentials. Paste your key(s) below. Never commit this file.
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=

# Dashboard login (read-only site)
DASHBOARD_PASSWORD=change-me

# Account to track (without @) and poll interval (min 60s; mind your X API rate limits/quota)
X_USERNAME=
POLL_INTERVAL_SECONDS=300
PORT=3000

# Scanner: accounts to watch (comma-separated, no @), optional keyword filter, and Jev labelling.
# Discovery is English-only in both search and timeline fallback.
X_WATCH_ACCOUNTS=
X_SEARCH_QUERY=
X_INCLUDE_REPLIES=false
MAX_POSTS_PER_POLL=10
JEV_API_KEY=
JEV_CONCURRENCY=4
JEV_PREFERENCE=

# Reply-opportunity tuning for @dreamworkhq
# Slack is OFF when neither delivery method is set. Qualified posts are always listed at /qualified.
SLACK_WEBHOOK_URL=
# For a Slack Connect channel owned by another organization, use the app's
# chat:write bot token and the channel ID. These take precedence over the webhook.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Slack cannot reliably preview x.com links. The default FixupX host supplies
# preview metadata and redirects clicks to X. Set blank to use direct x.com links.
SLACK_X_PREVIEW_DOMAIN=fixupx.com
# The scanner samples up to 10 English posts per hour from 5 AM to 3 PM Eastern.
# Posts are re-read 30 minutes later. Engagement/hour is the observed gain in
# likes, bookmarks, reposts, and replies, projected to one hour.
# The 0-10 score weights active interactions above passive views.
MIN_VELOCITY_PER_HOUR=20
MIN_ENGAGEMENT_SCORE=2
MAX_POST_AGE_HOURS=24
# Up to 10 fresh, Jev-approved, content-safe posts are sent in one Slack batch
# at 8 AM and 4 PM Eastern (up to 20/day). Empty batches do not send a message.
# Optional: override the built-in Dreamwork description used in the prompt
DREAMWORK_DESCRIPTION=

# Growth tracking
# Discovery only pulls posts that already have at least this many likes (cheaper: posts without traction are never read). 0 = no floor.
DISCOVERY_MIN_LIKES=5
# The 30-minute recheck is required. Optional later checks (minutes since discovery):
RECHECK_MINUTES=
