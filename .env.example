# SERVER configuration template. Copy for a new setup only; preserve existing .env.
# Never commit real .env files or print credentials. Empty values disable external access.
# npm start with credentials is LIVE, not a test: startup may poll/resume/send.

# X Developer API: use an existing authorized bearer token; do not create credentials.
# X_API_KEY/X_API_SECRET are not used by this server.
X_BEARER_TOKEN=

# Dashboard login (required). Keep the production password secret.
DASHBOARD_PASSWORD=
# Optional existing session-signing secret; blank generates an ephemeral secret at startup.
# This is not an instruction to create/configure a new persistent credential.
SESSION_SECRET=
PORT=3200
# Bind locally behind the deployment's verified HTTPS proxy; preserve its existing routing.
BIND_ADDRESS=127.0.0.1
# Direct Node path; compose.yaml overrides DATA_DIR to /app/data and mounts ./data.
DATA_DIR=./data
POLL_INTERVAL_SECONDS=300

# Optional account profile/follower tracking and one <=10-post baseline per UTC day.
X_USERNAME=
# Extra watched accounts (comma-separated, no @), added to built-in defaults.
# Reply defaults: jantegze, Adam_Karpiak, HungLee, GergelyOrosz.
X_WATCH_ACCOUNTS=
# Inspiration defaults: tristan_cte, codyschneider, benln.
X_INSPIRATION_ACCOUNTS=
# Broad reply discovery remains independent of watched accounts.
# Blank uses the built-in jobs/hiring query. Multiple alternatives separated by ||
# rotate through the 7 AM and 9 AM America/New_York discovery slots.
X_SEARCH_QUERY=
X_SEARCH_QUERIES=
X_INCLUDE_REPLIES=false

# Fixed RAW returned-post budget: 100 per UTC day, not an X billing entitlement.
# broad=30, watch=10, first_refresh=40, baseline=10, flex=10; no env cap override.
# Counts duplicate/filtered posts and repeat reads. Unknown outcomes retain reservations.
# Preserve DATA_DIR, x-budget.json, x-budget.initialized and all claims across restarts.
# Legacy state without a ledger exhausts the migration day; do not delete state to evade it.
# NEVER start a fresh ledger mid-day after old uncapped reads; see docs/deployment.md.
# Discovery: 7/9 AM broad replies, 8 AM watched, 10 AM inspiration, 11 AM watch remainder.
# Search pages request 10; timeline fallback minimum is 5; old MAX_POSTS_PER_POLL and
# MAX_SEARCH_PAGES_PER_POLL settings do not enlarge the fixed schedule/allowances.

# Existing Jev authorization. Missing key means no new qualified picks.
JEV_API_KEY=
JEV_CONCURRENCY=4
JEV_PREFERENCE=
DREAMWORK_DESCRIPTION=

# BOTH reply and inspiration picks are approved only for private #ark-dreamwork.
# One noon America/New_York batch, max 10 total incl. max 3 inspiration; no empty spam.
# Verify existing token identity, channel privacy, membership and chat:write before rollout.
# Stop if this needs new credentials or expanded access; get authorization separately.
SLACK_BOT_TOKEN=
# Destination is fixed in code to C0C1BAFBEFK; this legacy variable cannot override it.
SLACK_CHANNEL_ID=C0C1BAFBEFK
# Legacy webhook delivery is intentionally DISABLED: its destination is unverifiable.
SLACK_WEBHOOK_URL=
# Public post-link previews via FixupX; blank uses direct x.com links.
SLACK_X_PREVIEW_DOMAIN=fixupx.com

# Existing quality gates stay strict. Two observations >=30 min apart are required.
# Engagement/hour = observed gain in likes + bookmarks + reposts + replies / elapsed hours.
# Score is 0-10; a legacy 0-1000 threshold is normalized for compatibility.
MIN_VELOCITY_PER_HOUR=20
MIN_ENGAGEMENT_SCORE=2
MAX_POST_AGE_HOURS=24
# Server-side search operator, if supported by the X account; 0 disables it.
DISCOVERY_MIN_LIKES=5
# Required first refresh at 30 min; optional later minutes (>30) spend flex allowance.
RECHECK_MINUTES=
